# Generate a random secret of at least 32 characters.
API_KEY=
HOST=0.0.0.0
PORT=8080
EXCHANGE_CREDENTIALS_JSON={}
DATABASE_URL=
GIT_SHA=unknown
TRADING_ENABLED=false
MARKET_ORDERS_ENABLED=false

# Connection lifecycle (Node uses milliseconds; Python uses seconds).
EXCHANGE_IDLE_TTL_MS=60000
EXCHANGE_MAX_INSTANCES=32
EXCHANGE_TIMEOUT_MS=30000
WS_IDLE_GRACE_MS=10000
WS_MAX_CLIENTS=500
WS_MAX_STREAMS=1000

# Market-data cache (Node uses milliseconds; Python uses seconds).
CACHE_MAX_ENTRIES=10000
CACHE_TICKER_TTL_MS=2000
CACHE_ORDERBOOK_TTL_MS=1000
CACHE_TRADES_TTL_MS=1000
CACHE_OHLCV_TTL_MS=5000
CACHE_MARKETS_TTL_MS=300000

# Per-client REST and WebSocket command token bucket.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
